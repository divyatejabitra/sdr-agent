OPENAI_API_KEY=
# Optional. Without this, research uses only the lead file and extra_notes.
SERPER_API_KEY=

# Optional. Each enables real cross-model diversity for one of the three draft
# voices (consultative -> Anthropic, curious -> Google Gemini) instead of three
# prompts on the same model. Missing either falls back to OpenAI for that
# voice - the crew still runs fine with just OPENAI_API_KEY set.
# GOOGLE_API_KEY from aistudio.google.com/apikey: crewai's native Gemini
# provider only accepts a classic "AIzaSy..." key, but the "curious" voice
# here goes through Gemini's OpenAI-compatible endpoint instead (same trick
# 2_openai/3_lab3.ipynb uses), which also accepts the "AQ...." Auth-key format
# - use whichever one your AI Studio account actually gives you.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Drafts are always written to output/. Delivery is off unless you opt in.
SEND_EMAILS=false
# When true (and SEND_EMAILS is true), ask y/N in the terminal before each send.
# Unattended runs with no terminal never send while this is on.
REQUIRE_APPROVAL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# JSON object (one lead) or use run_batch with a JSON array.
# LEADS_FILE=data/sample_lead.json
